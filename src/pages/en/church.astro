---
import Layout from "~/layouts/PageLayout.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import Steps from "~/components/widgets/Steps.astro";
import GradientText from "~/components/ui/GradientText.astro";
import { useTranslations } from "~/i18n/utils";

const metadata = {
  title: "The Church",
};

const { lang = "en" } = Astro.props;

const t = useTranslations(lang);
---

<Layout lang={lang} metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline={t("church.herotext.tagline")}>
    <Fragment slot="title">
      {t("church.herotext.title1")}
      <GradientText text={t("church.herotext.title.span")} />
      {t("church.herotext.title2")}
    </Fragment>

    <Fragment slot="subtitle">
      {t("church.herotext.subtitle1")}
      <span class="font-semibold">{t("church.herotext.subtitle.span1")} </span>
      {t("church.herotext.subtitle2")}
      <GradientText class="font-bold" text={t("church.herotext.subtitle.span2")} />
      {t("church.herotext.subtitle3")}
    </Fragment>
  </HeroText>

  <!-- Steps Widget ****************** -->

  <Steps
    tagline={t("church.steps.tagline")}
    title={t("church.steps.title")}
    isReversed={true}
    classes={{ container: "md:pb-0 lg:pb-0 xl:pb-0" }}
    items={[
      {
        title: t("church.steps.items.1.title"),
        description: [
          { text: t("church.steps.items.1.description1") },
          { text: t("church.steps.items.1.description2") },
          { text: t("church.steps.items.1.description3") },
        ],
        icon: "tabler:number-1",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.2.title"),
        description: [
          { text: t("church.steps.items.2.description1") },
          { text: t("church.steps.items.2.description2") },
          { text: t("church.steps.items.2.description3") },
        ],
        icon: "tabler:number-2",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.3.title"),
        description: [
          { text: t("church.steps.items.3.description1") },
          { text: t("church.steps.items.3.description2") },
          { text: t("church.steps.items.3.description3") },
        ],
        icon: "tabler:number-3",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.4.title"),
        description: [
          { text: t("church.steps.items.4.description1") },
          { text: t("church.steps.items.4.description2") },
          { subtitle: true, text: t("church.steps.items.4.description3") },
          { text: t("church.steps.items.4.description4") },
          { text: t("church.steps.items.4.description5") },
          { subtitle: true, text: t("church.steps.items.4.description6") },
          { text: t("church.steps.items.4.description7") },
          { text: t("church.steps.items.4.description8") },
        ],
        icon: "tabler:number-4",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.5.title"),
        description: [
          { text: t("church.steps.items.5.description1") },
          { text: t("church.steps.items.5.description2") },
          { subtitle: true, text: t("church.steps.items.5.description3") },
          { text: t("church.steps.items.5.description4") },
          { text: t("church.steps.items.5.description5") },
        ],
        icon: "tabler:number-5",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.6.title"),
        description: [
          { text: t("church.steps.items.6.description1") },
          { text: t("church.steps.items.6.description2") },
        ],
        icon: "tabler:number-6",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.7.title"),
        description: [
          { text: t("church.steps.items.7.description1") },
          { text: t("church.steps.items.7.description2") },
          { text: t("church.steps.items.7.description3") },
        ],
        icon: "tabler:number-7",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.8.title"),
        description: [
          { text: t("church.steps.items.8.description1") },
          { text: t("church.steps.items.8.description2") },
          { text: t("church.steps.items.8.description3") },
        ],
        icon: "tabler:number-8",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:py-0 lg:py-0 xl:py-0" }}
    items={[
      {
        title: t("church.steps.items.9.title"),
        description: [
          { text: t("church.steps.items.9.description1") },
          { text: t("church.steps.items.9.description2") },
          { text: t("church.steps.items.9.description3") },
          { text: t("church.steps.items.9.description4") },
        ],
        icon: "tabler:number-9",
      },
    ]}
  />

  <Steps
    isReversed={true}
    classes={{ container: "md:pt-0 lg:pt-0 xl:pt-0" }}
    items={[
      {
        title: t("church.steps.items.10.title"),
        description: [
          { text: t("church.steps.items.10.description1") },
          { text: t("church.steps.items.10.description2") },
        ],
        icon: "tabler:check",
      },
    ]}
  />
</Layout>
